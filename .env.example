# 数据库
DATABASE_URL="postgresql://selfpraise:selfpraise_dev@localhost:5432/selfpraise"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 服务端口
PORT=3000

# JWT
JWT_SECRET=selfpraise-dev-secret
JWT_REFRESH_SECRET=selfpraise-dev-refresh-secret
# access 固定 30 分钟（开发/生产一致）；过期后由客户端用 refreshToken 刷新
JWT_ACCESS_EXPIRES_SECONDS=1800
# refresh 默认 180 天
JWT_REFRESH_EXPIRES_SECONDS=15552000

# Agnes AI (agnes-ai.com)
AGNES_API_KEY=
AGNES_MODEL=agnes-2.0-flash
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# 向量嵌入（空 = 关闭向量，画像按算法召回；local = 本机 Ollama BGE-M3）
EMBEDDING_MODE=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 短信服务
SMS_PROVIDER=dev

# 后台管理台（独立 Admin JWT，与 C 端用户 JWT 隔离）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_ADMIN_SECRET=selfpraise-admin-dev-secret
JWT_ADMIN_EXPIRES_SECONDS=28800
