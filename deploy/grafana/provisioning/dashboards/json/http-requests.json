{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "纵轴为该时间桶内的请求次数（整数）。时间桶随看板范围自动放大，最小 1 分钟。",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "barAlignment": 0,
            "stacking": { "mode": "none" }
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "interval": "1m",
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "round(sum(increase(http_requests_total[$__interval])))",
          "legendFormat": "请求次数",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "全站请求次数（按时间桶，最小 1 分钟）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "按 method + route 拆分；纵轴为桶内请求次数。",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 2,
      "interval": "1m",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum", "max"]
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "round(sum by (method, route) (increase(http_requests_total[$__interval])))",
          "legendFormat": "{{method}} {{route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "按接口请求次数（按时间桶，最小 1 分钟）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "LLM 流式/非流式调用耗时分位数。phase=ttft 为首 token；total 为整段结束。",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "id": 3,
      "interval": "1m",
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, phase) (rate(llm_request_duration_seconds_bucket{status=\"ok\"}[5m])))",
          "legendFormat": "p50 {{phase}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(llm_request_duration_seconds_bucket{status=\"ok\"}[5m])))",
          "legendFormat": "p95 {{phase}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "LLM 耗时 P50 / P95（ttft / total）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "LLM 调用次数（含 ok / error / fake）。",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 35,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
      "id": 4,
      "interval": "1m",
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (operation, status) (rate(llm_request_duration_seconds_count[5m]))",
          "legendFormat": "{{operation}} {{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "LLM 调用速率（按 operation / status）",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["hugme", "http", "llm"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["15s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "HugMe HTTP 请求",
  "uid": "hugme-http-requests",
  "version": 3
}
